[Unit]
Description=Automic Vault encrypted Approval relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=av-approval-relay
Group=av-approval-relay
WorkingDirectory=/apps/av-approval-relay/current
EnvironmentFile=/etc/av-approval-relay.env
ExecStart=/apps/av-approval-relay/current/av-approval-relay
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/av-approval-relay
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
