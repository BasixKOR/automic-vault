{
  "name": "automic-vault-varlock-sample",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node app.mjs",
    "test": "npm run test:sample && npm run test:batch",
    "test:sample": "AUTOMIC_VAULT_VARLOCK_HELPER=./mock-helper.mjs AUTOMIC_VAULT_VARLOCK_EXPECTED_NAMES=VARLOCK_SAMPLE_SECRET node app.mjs",
    "test:batch": "cd batch-fixture && AUTOMIC_VAULT_VARLOCK_HELPER=../mock-helper.mjs AUTOMIC_VAULT_VARLOCK_EXPECTED_NAMES=VARLOCK_SAMPLE_FIRST,VARLOCK_SAMPLE_SECOND node app.mjs"
  },
  "dependencies": {
    "@automicvault/varlock-plugin": "file:..",
    "varlock": "^1.16.1"
  }
}
