#!/bin/zsh
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SOCKET_PATH="${VAULT_SOCKET_PATH:-$HOME/Library/Application Support/Automic Vault/vault.sock}"
export ROOT_DIR SOCKET_PATH

cargo run \
  --manifest-path "$ROOT_DIR/Cargo.toml" \
  --bin av \
  -- contain toolchain \
  --socket "$SOCKET_PATH" \
  --json
