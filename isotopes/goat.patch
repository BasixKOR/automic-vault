+	secretBytes, err := json.Marshal(secrets)
@@ -40 +64,7 @@ func persistAuthSession(sess *AuthSession) error {
-	defer f.Close()
+	if err := avCredential("store", sess.DID.String(), sess.PDS, secretBytes); err != nil {
