diff --git c/config/av.go i/config/av.go
new file mode 100644
index 0000000..5857a2e
--- /dev/null
+++ i/config/av.go
@@ -0,0 +1,88 @@
+package config
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os/exec"
+)
+
+const (
+	avPath           = "/usr/local/bin/av"
+	avMarker         = "{\"automic_vault\":\"plumber-config-v1\"}\n"
+	avMaxConfigBytes = 1024 * 1024
+)
+
+var (
+	avTestEnabled bool
+	avTestConfig  []byte
+)
+
+func enableAVConfigTestStore() {
+	avTestEnabled = true
+	avTestConfig = nil
+}
+
+func hydrateAVConfig(data []byte) ([]byte, error) {
+	if !bytes.Equal(bytes.TrimSpace(data), bytes.TrimSpace([]byte(avMarker))) {
+		return nil, errors.New("Plumber config is not under Automic Vault custody; run `av harden plumber`")
+	}
+	output, err := runAV("get", nil)
+	if err != nil {
+		return nil, err
+	}
+	if err := validAVConfig(output); err != nil {
+		return nil, err
+	}
+	return output, nil
+}
+
+func storeAVConfig(data []byte) error {
+	if err := validAVConfig(data); err != nil {
+		return err
+	}
+	_, err := runAV("store", data)
+	return err
+}
+
+func validAVConfig(data []byte) error {
+	if len(data) == 0 || len(data) > avMaxConfigBytes || bytes.IndexByte(data, 0) >= 0 {
+		return errors.New("invalid Plumber config")
+	}
+	var root map[string]json.RawMessage
+	if err := json.Unmarshal(data, &root); err != nil || root == nil {
+		return errors.New("invalid Plumber config")
+	}
+	if bytes.Equal(bytes.TrimSpace(data), bytes.TrimSpace([]byte(avMarker))) {
+		return errors.New("refusing to store the Plumber custody marker")
+	}
+	return nil
+}
+
+func runAV(action string, input []byte) ([]byte, error) {
+	if avTestEnabled {
+		switch action {
+		case "get":
+			if len(avTestConfig) == 0 {
+				return nil, errors.New("test Plumber config store is empty")
+			}
+			return append([]byte(nil), avTestConfig...), nil
+		case "store":
+			avTestConfig = append([]byte(nil), input...)
+			return nil, nil
+		default:
+			return nil, errors.New("unsupported Plumber config helper action")
+		}
+	}
+	cmd := exec.Command(avPath, "plumber-credential", action)
+	cmd.Stdin = bytes.NewReader(input)
+	output, err := cmd.Output()
+	if err != nil {
+		return nil, fmt.Errorf("Automic Vault Plumber config helper failed: %w", err)
+	}
+	if len(output) > avMaxConfigBytes+1 {
+		return nil, errors.New("Plumber config exceeds 1 MiB")
+	}
+	return bytes.TrimSuffix(output, []byte("\n")), nil
+}
diff --git c/config/av_test.go i/config/av_test.go
new file mode 100644
index 0000000..884d64e
--- /dev/null
+++ i/config/av_test.go
@@ -0,0 +1,42 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestAVConfigRoundTripAndPlaintextRejection(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	enableAVConfigTestStore()
+
+	cfg := newConfig(false, nil)
+	cfg.Token = "streamdal-token"
+	if err := cfg.Save(); err != nil {
+		t.Fatal(err)
+	}
+	onDisk, err := os.ReadFile(filepath.Join(os.Getenv("HOME"), ConfigDir, ConfigFilename))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(onDisk) != avMarker {
+		t.Fatalf("config on disk = %q, want marker", onDisk)
+	}
+	loaded, err := fetchConfigFromFile(ConfigFilename)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if loaded.Token != "streamdal-token" {
+		t.Fatalf("loaded token = %q", loaded.Token)
+	}
+
+	if err := os.WriteFile(filepath.Join(os.Getenv("HOME"), ConfigDir, ConfigFilename), []byte(`{"token":"plaintext"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := fetchConfigFromFile(ConfigFilename); err == nil {
+		t.Fatal("plaintext config was accepted")
+	}
+	if _, err := New(false, nil); err == nil {
+		t.Fatal("plaintext config load did not fail closed")
+	}
+}
