@@ -0,0 +1,8 @@
+# aws-sso-cli Radioisotope Detector
+
+This detector reports cached aws-sso-cli token files.
+
+aws-sso-cli stores SSO token material under `~/.aws-sso/cache`. Those cache
+files are mutable upstream state, so this radioisotope is detect-only.
+
+Automic Vault does not wrap or migrate aws-sso-cli credentials yet.
diff --git a/aws-sso-cli/automic-vault.yml b/aws-sso-cli/automic-vault.yml
new file mode 100644
index 0000000..c5a06e8
--- /dev/null
+++ b/aws-sso-cli/automic-vault.yml
@@ -0,0 +1,19 @@
+name:
+  isotope:aws-sso-cli
+
+modifies:
+  brew:aws-sso-cli
+
+justification:
+  title:
+    Plain Text aws-sso-cli Token Cache
+  detail: |
+    aws-sso-cli can cache SSO access and refresh tokens under ~/.aws-sso.
+
+    Automic Vault detects cached token material but does not migrate it because
+    the cache is mutable upstream state.
+
+caveats:
+  - This radioisotope is detect-only.
+  - We detect JSON cache files under ~/.aws-sso/cache.
+  - Expired cache entries are still reported if token material remains.
diff --git a/aws-sso-cli/detect.rs b/aws-sso-cli/detect.rs
new file mode 100644
index 0000000..a749efd
--- /dev/null
+++ b/aws-sso-cli/detect.rs
@@ -0,0 +1,97 @@
+use std::path::{Path, PathBuf};
+
+pub fn install_is_insecure() -> Result<bool, String> {
+    install_insecurity_reasons().map(|reasons| !reasons.is_empty())
+}
+
+pub fn install_insecurity_reasons() -> Result<Vec<String>, String> {
+    let cache = aws_sso_cache_dir()?;
+    if !cache.exists() {
+        return Ok(Vec::new());
+    }
+
+    let mut reasons = Vec::new();
+    for entry in read_dir(&cache)? {
+        let path = entry?;
+        if path.extension().and_then(|value| value.to_str()) != Some("json") {
+            continue;
+        }
+        if token_cache_contains_secret(&read_to_string(&path)?) {
+            reasons.push(format!(
+                "aws-sso-cli cache contains plaintext SSO token material: {}",
+                path.display()
+            ));
+        }
+    }
+    reasons.sort();
+    reasons.dedup();
+    Ok(reasons)
+}
+
+fn aws_sso_cache_dir() -> Result<PathBuf, String> {
+    Ok(home_dir()?.join(".aws-sso/cache"))
+}
+
+fn home_dir() -> Result<PathBuf, String> {
+    std::env::var_os("HOME")
+        .map(PathBuf::from)
+        .ok_or_else(|| "HOME is not set".to_string())
+}
+
+fn read_dir(path: &Path) -> Result<Vec<Result<PathBuf, String>>, String> {
+    let entries = std::fs::read_dir(path)
+        .map_err(|err| format!("failed to read {}: {err}", path.display()))?;
+    Ok(entries
+        .map(|entry| {
+            entry
+                .map(|entry| entry.path())
+                .map_err(|err| format!("failed to read entry in {}: {err}", path.display()))
+        })
+        .collect())
+}
+
+fn read_to_string(path: &Path) -> Result<String, String> {
+    std::fs::read_to_string(path).map_err(|err| format!("failed to read {}: {err}", path.display()))
+}
+
+fn token_cache_contains_secret(contents: &str) -> bool {
+    ["accessToken", "refreshToken", "clientSecret"]
+        .iter()
+        .any(|key| contains_json_string_value(contents, key))
+}
+
+fn contains_json_string_value(contents: &str, key: &str) -> bool {
+    let needle = format!("\"{key}\"");
+    let mut remaining = contents;
+    while let Some(key_index) = remaining.find(&needle) {
+        let Some(after_key) = remaining[key_index..].split_once(':').map(|(_, value)| value) else {
+            return false;
+        };
+        let value = after_key.trim_start();
+        if value.starts_with('"') && value.get(1..).is_some_and(|value| !value.starts_with('"')) {
+            return true;
+        }
+        if after_key.is_empty() {
+            return false;
+        }
+        remaining = &after_key[1..];
+    }
+    false
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn detects_sso_token_cache_values() {
+        assert!(token_cache_contains_secret(r#"{"accessToken":"token"}"#));
+        assert!(token_cache_contains_secret(r#"{"refreshToken":"refresh"}"#));
+        assert!(token_cache_contains_secret(r#"{"clientSecret":"secret"}"#));
+    }
+
+    #[test]
+    fn ignores_empty_cache_values() {
+        assert!(!token_cache_contains_secret(r#"{"accessToken":""}"#));
+    }
+}
