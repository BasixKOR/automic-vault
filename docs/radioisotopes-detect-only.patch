+
+modifies:
+  brew:saml2aws
+
+justification:
+  title:
+    Plain Text saml2aws Passwords
+  detail: |
+    saml2aws can store IdP passwords and MFA secrets in ~/.saml2aws.
+
+    Automic Vault detects plaintext saml2aws secret fields but does not migrate
+    them because the file is mutable upstream configuration.
+
+caveats:
+  - This radioisotope is detect-only.
+  - We detect ~/.saml2aws.
+  - Environment variable and keychain-backed flows are not reported.
diff --git a/saml2aws/detect.rs b/saml2aws/detect.rs
new file mode 100644
index 0000000..d74dc79
--- /dev/null
+++ b/saml2aws/detect.rs
@@ -0,0 +1,74 @@
+use std::path::{Path, PathBuf};
+
+pub fn install_is_insecure() -> Result<bool, String> {
+    install_insecurity_reasons().map(|reasons| !reasons.is_empty())
+}
+
+pub fn install_insecurity_reasons() -> Result<Vec<String>, String> {
+    let path = saml2aws_config_path()?;
+    if path.exists() && saml2aws_config_contains_secret(&read_to_string(&path)?) {
+        return Ok(vec![format!(
+            "saml2aws config contains plaintext secret fields: {}",
+            path.display()
+        )]);
+    }
+    Ok(Vec::new())
+}
+
+fn saml2aws_config_path() -> Result<PathBuf, String> {
+    Ok(home_dir()?.join(".saml2aws"))
+}
+
+fn home_dir() -> Result<PathBuf, String> {
+    std::env::var_os("HOME")
+        .map(PathBuf::from)
+        .ok_or_else(|| "HOME is not set".to_string())
+}
+
+fn read_to_string(path: &Path) -> Result<String, String> {
+    std::fs::read_to_string(path).map_err(|err| format!("failed to read {}: {err}", path.display()))
+}
+
+fn saml2aws_config_contains_secret(contents: &str) -> bool {
+    contents.lines().any(|line| {
+        let line = line.split('#').next().unwrap_or("").trim();
+        if line.is_empty() || line.starts_with('[') {
+            return false;
+        }
+        let Some((key, value)) = line.split_once('=') else {
+            return false;
+        };
+        let key = key.trim().to_ascii_lowercase();
+        matches!(
+            key.as_str(),
+            "password" | "mfa_secret" | "mfa-token" | "mfa_token" | "secret_key"
+        ) && plaintext_value(value)
+    })
+}
+
+fn plaintext_value(value: &str) -> bool {
+    let value = value.trim().trim_matches('"').trim_matches('\'');
+    !value.is_empty() && !value.contains("${") && !value.eq_ignore_ascii_case("changeme")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn detects_password_and_mfa_secret() {
+        assert!(saml2aws_config_contains_secret(
+            "[profile]\npassword = secret\n"
+        ));
+        assert!(saml2aws_config_contains_secret(
+            "[profile]\nmfa_secret = 123456\n"
+        ));
+    }
+
+    #[test]
+    fn ignores_placeholders_and_comments() {
+        assert!(!saml2aws_config_contains_secret(
+            "# password = secret\n[profile]\npassword = ${SAML_PASSWORD}\n"
+        ));
+    }
+}
